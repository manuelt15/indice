# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local.

# Base de datos (Neon, región Frankfurt). Cadenas "pooled" del panel de Neon.
# Pega la del rol dueño en DATABASE_URL y ejecuta `npm run db:setup`:
# la mueve a DATABASE_URL_OWNER (solo migraciones) y pone en DATABASE_URL la del rol indice_app.
DATABASE_URL=
DATABASE_URL_OWNER=

# Better Auth
# Secreto de 32+ bytes aleatorios: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL de la app (en local, el puerto del servidor de desarrollo)
BETTER_AUTH_URL=http://localhost:3100

# Login con Google (Google Cloud Console > Credenciales > ID de cliente OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login con GitHub (GitHub > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mapa del footer. Clave personal de https://carto.com/basemaps/apikey/
CARTO_BASEMAPS_API_KEY=
